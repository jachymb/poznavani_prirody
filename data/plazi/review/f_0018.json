{
 "drop_facts": [
  {"id": "Q18867#0", "why": "suchozemská želva a mlži jsou nepravděpodobná kombinace, zřejmě záměna za plže"},
  {"id": "Q188690#10", "why": "„jeho“ nemá v tvrzení podmět, nedává smysl bez článku; „největší nepřítel“ je sporné"},
  {"id": "Q1887786#1", "why": "přidává slovo „jen“, které v citaci není"},
  {"id": "Q192056#7", "why": "sporné: žížaly a slimáci nejsou doložená běžná potrava zmije"},
  {"id": "Q1970700#1", "why": "chyba: druh žije na východním a severovýchodním Madagaskaru, vlhké nížiny nejsou na západě"},
  {"id": "Q199458#0", "why": "nejasný podmět (čí vejce a mláďata); malí mořští savci jako hlavní predátoři jsou sporní"},
  {"id": "Q199458#1", "why": "biologicky nepřesné „jen“: dospělé kořistí i kosatky, krokodýli mořští a jaguáři"}
